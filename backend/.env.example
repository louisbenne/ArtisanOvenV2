# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=artisanoven
DB_USER=artisanoven
DB_PASS=changeme
DB_POOL_MAX=10

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
FRONTEND_URL=https://artisanoven.shop
FRONTEND_ORIGIN=https://artisanoven.shop

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Leave blank to run in stub mode (logs to console instead of sending).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@artisanoven.shop

# ── WhatsApp Cloud API (Meta) — Phase 4 ──────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# ── PayPal ────────────────────────────────────────────────────────────────────
PAYPAL_WEBHOOK_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
