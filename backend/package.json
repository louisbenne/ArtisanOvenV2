{
  "name": "artisan-oven-backend",
  "version": "2.0.0",
  "description": "Artisan Oven v2 backend — Node/Express + PostgreSQL",
  "main": "server.js",
  "scripts": {
    "start":    "node server.js",
    "dev":      "node --watch server.js",
    "migrate":  "node src/db/migrate.js",
    "lint":     "node --check server.js src/**/*.js",
    "test":     "node --test --test-concurrency=1",
    "seed:admin": "node scripts/seed-admin.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcrypt":    "^5.1.1",
    "cors":      "^2.8.5",
    "dotenv":    "^16.4.5",
    "express":   "^4.21.0",
    "nodemailer": "^6.9.14",
    "postgres":  "^3.4.4",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {}
}
