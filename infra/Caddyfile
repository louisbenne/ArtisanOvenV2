# SITE_ADDRESS comes from docker-compose (default: localhost).
#   Production: SITE_ADDRESS=artisanoven.shop  → real Let's Encrypt cert
#   Local:      SITE_ADDRESS=localhost         → Caddy's local CA (self-signed)
{$SITE_ADDRESS:localhost} {
    # The backend serves the API, Socket.IO, and the static frontend/admin
    # files (same as on Railway), so Caddy just terminates TLS and proxies.
    reverse_proxy backend:3000

    encode gzip zstd

    header {
        X-Frame-Options        DENY
        X-Content-Type-Options nosniff
        Referrer-Policy        strict-origin-when-cross-origin
        -Server
    }
}
