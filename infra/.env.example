# ArtisanOven v2 — the ONE env file. Copy to infra/.env and fill in.
# Used by `npm run dev` (dev overrides DB/SMTP) and `npm run prod:up`.

# ── Database ──────────────────────────────────────────────────────────────────
# Postgres password (the db container is created with it). Required in prod.
DB_PASS=changeme
DB_POOL_MAX=10
# Only for an external Postgres that needs TLS:
# DB_SSL=true
# DATABASE_URL=postgres://user:pass@host:5432/db

# ── Site ──────────────────────────────────────────────────────────────────────
# Caddy site address: artisanoven.shop in production, localhost for testing.
SITE_ADDRESS=localhost
FRONTEND_URL=https://artisanoven.shop
FRONTEND_ORIGIN=https://artisanoven.shop

# ── Admin seed (backend/scripts/seed-admin.js) ────────────────────────────────
ADMIN_USERNAME=louis
# ADMIN_PASSWORD=   ← set only while running the seed script, then remove
# PARENT_ACCESS_CODE=   ← optional: creates/re-activates the parent order code

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Leave SMTP_HOST blank for stub mode (logs instead of sending).
# Dev always uses Mailpit regardless of these values.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@artisanoven.shop

# ── WhatsApp Cloud API (disabled for launch, D5) ──────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# ── PayPal webhooks (disabled for launch, D5) ─────────────────────────────────
PAYPAL_MODE=live
PAYPAL_WEBHOOK_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
